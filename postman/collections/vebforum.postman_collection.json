{
	"info": {
		"_postman_id": "a1b2c3d4-1111-4a2b-9c3d-vebforum000001",
		"name": "VebForum API",
		"description": "REST API za forum aplikaciju (Laravel + Sanctum). Uvezi i environment 'VebForum - Local', pa izaberi ga pre slanja zahteva.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    pm.environment.set('token', pm.response.json().token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] }
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.environment.set('token', pm.response.json().token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
					}
				},
				{
					"name": "Login as Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.environment.set('admin_token', pm.response.json().token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
						},
						"url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": { "raw": "{{base_url}}/user", "host": ["{{base_url}}"], "path": ["user"] }
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
					}
				},
				{
					"name": "Forgot Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.environment.set('reset_token', pm.response.json().reset_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\"\n}"
						},
						"url": { "raw": "{{base_url}}/forgot-password", "host": ["{{base_url}}"], "path": ["forgot-password"] }
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"token\": \"{{reset_token}}\",\n  \"password\": \"newPassword123\",\n  \"password_confirmation\": \"newPassword123\"\n}"
						},
						"url": { "raw": "{{base_url}}/reset-password", "host": ["{{base_url}}"], "path": ["reset-password"] }
					}
				},
				{
					"name": "Unauthenticated Request (401 JSON)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"x\",\n  \"body\": \"y\",\n  \"category_id\": 1\n}"
						},
						"url": { "raw": "{{base_url}}/topics", "host": ["{{base_url}}"], "path": ["topics"] }
					}
				}
			]
		},
		{
			"name": "Categories",
			"item": [
				{
					"name": "List Categories (paginated, cached)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/categories?page=1", "host": ["{{base_url}}"], "path": ["categories"], "query": [ { "key": "page", "value": "1" } ] }
					}
				},
				{
					"name": "Show Category",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/categories/{{category_id}}", "host": ["{{base_url}}"], "path": ["categories", "{{category_id}}"] }
					}
				},
				{
					"name": "List Topics in Category (nested route)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/categories/{{category_id}}/topics", "host": ["{{base_url}}"], "path": ["categories", "{{category_id}}", "topics"] }
					}
				},
				{
					"name": "Create Category (admin)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Programiranje\",\n  \"description\": \"Diskusije o programiranju\"\n}"
						},
						"url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] }
					}
				},
				{
					"name": "Update Category (admin)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Programiranje i razvoj\",\n  \"description\": \"Izmenjen opis kategorije\"\n}"
						},
						"url": { "raw": "{{base_url}}/categories/{{category_id}}", "host": ["{{base_url}}"], "path": ["categories", "{{category_id}}"] }
					}
				},
				{
					"name": "Delete Category (admin)",
					"request": {
						"method": "DELETE",
						"header": [ { "key": "Authorization", "value": "Bearer {{admin_token}}" } ],
						"url": { "raw": "{{base_url}}/categories/{{category_id}}", "host": ["{{base_url}}"], "path": ["categories", "{{category_id}}"] }
					}
				}
			]
		},
		{
			"name": "Topics",
			"item": [
				{
					"name": "List Topics (pagination, filter, sort)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/topics?title=laravel&sort=-created_at&page=1",
							"host": ["{{base_url}}"],
							"path": ["topics"],
							"query": [
								{ "key": "title", "value": "laravel" },
								{ "key": "sort", "value": "-created_at" },
								{ "key": "page", "value": "1" }
							]
						}
					}
				},
				{
					"name": "Show Topic",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/topics/{{topic_id}}", "host": ["{{base_url}}"], "path": ["topics", "{{topic_id}}"] }
					}
				},
				{
					"name": "List Posts in Topic (nested route)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/topics/{{topic_id}}/posts", "host": ["{{base_url}}"], "path": ["topics", "{{topic_id}}", "posts"] }
					}
				},
				{
					"name": "Search Topics",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/search/topics?query=laravel", "host": ["{{base_url}}"], "path": ["search", "topics"], "query": [ { "key": "query", "value": "laravel" } ] }
					}
				},
				{
					"name": "Topic Statistics (JOIN + subqueries)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/statistics/topics", "host": ["{{base_url}}"], "path": ["statistics", "topics"] }
					}
				},
				{
					"name": "Create Topic",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Najbolje prakse u Laravelu\",\n  \"body\": \"Koje pakete i prakse koristite u svojim Laravel projektima?\",\n  \"category_id\": {{category_id}}\n}"
						},
						"url": { "raw": "{{base_url}}/topics", "host": ["{{base_url}}"], "path": ["topics"] }
					}
				},
				{
					"name": "Create Topic - Blocked by Profanity Filter",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"You are an idiot\",\n  \"body\": \"This is a damn stupid topic body.\",\n  \"category_id\": {{category_id}}\n}"
						},
						"url": { "raw": "{{base_url}}/topics", "host": ["{{base_url}}"], "path": ["topics"] }
					}
				},
				{
					"name": "Update Topic",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Najbolje prakse u Laravelu (izmenjeno)\",\n  \"body\": \"Izmenjen opis teme.\",\n  \"category_id\": {{category_id}}\n}"
						},
						"url": { "raw": "{{base_url}}/topics/{{topic_id}}", "host": ["{{base_url}}"], "path": ["topics", "{{topic_id}}"] }
					}
				},
				{
					"name": "Vote on Topic",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"value\": 1\n}"
						},
						"url": { "raw": "{{base_url}}/topics/{{topic_id}}/vote", "host": ["{{base_url}}"], "path": ["topics", "{{topic_id}}", "vote"] }
					}
				},
				{
					"name": "Delete Topic",
					"request": {
						"method": "DELETE",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": { "raw": "{{base_url}}/topics/{{topic_id}}", "host": ["{{base_url}}"], "path": ["topics", "{{topic_id}}"] }
					}
				}
			]
		},
		{
			"name": "Posts",
			"item": [
				{
					"name": "List Posts (pagination, filter, sort)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/posts?sort=-created_at&page=1", "host": ["{{base_url}}"], "path": ["posts"], "query": [ { "key": "sort", "value": "-created_at" }, { "key": "page", "value": "1" } ] }
					}
				},
				{
					"name": "Show Post",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/posts/{{post_id}}", "host": ["{{base_url}}"], "path": ["posts", "{{post_id}}"] }
					}
				},
				{
					"name": "Create Post",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"body\": \"Ovo je moj odgovor u temi.\",\n  \"topic_id\": {{topic_id}}\n}"
						},
						"url": { "raw": "{{base_url}}/posts", "host": ["{{base_url}}"], "path": ["posts"] }
					}
				},
				{
					"name": "Update Post",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"body\": \"Izmenjen sadržaj posta.\",\n  \"topic_id\": {{topic_id}}\n}"
						},
						"url": { "raw": "{{base_url}}/posts/{{post_id}}", "host": ["{{base_url}}"], "path": ["posts", "{{post_id}}"] }
					}
				},
				{
					"name": "Toggle Post Like",
					"request": {
						"method": "POST",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": { "raw": "{{base_url}}/posts/{{post_id}}/like", "host": ["{{base_url}}"], "path": ["posts", "{{post_id}}", "like"] }
					}
				},
				{
					"name": "Delete Post",
					"request": {
						"method": "DELETE",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": { "raw": "{{base_url}}/posts/{{post_id}}", "host": ["{{base_url}}"], "path": ["posts", "{{post_id}}"] }
					}
				}
			]
		},
		{
			"name": "Comments",
			"item": [
				{
					"name": "List Comments for Post (nested route)",
					"request": {
						"method": "GET",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": { "raw": "{{base_url}}/posts/{{post_id}}/comments", "host": ["{{base_url}}"], "path": ["posts", "{{post_id}}", "comments"] }
					}
				},
				{
					"name": "Create Comment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"body\": \"Slažem se sa ovim postom.\"\n}"
						},
						"url": { "raw": "{{base_url}}/posts/{{post_id}}/comments", "host": ["{{base_url}}"], "path": ["posts", "{{post_id}}", "comments"] }
					}
				},
				{
					"name": "Update Comment",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"body\": \"Izmenjen komentar.\"\n}"
						},
						"url": { "raw": "{{base_url}}/comments/{{comment_id}}", "host": ["{{base_url}}"], "path": ["comments", "{{comment_id}}"] }
					}
				},
				{
					"name": "Toggle Comment Like",
					"request": {
						"method": "POST",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": { "raw": "{{base_url}}/comments/{{comment_id}}/like", "host": ["{{base_url}}"], "path": ["comments", "{{comment_id}}", "like"] }
					}
				},
				{
					"name": "Delete Comment",
					"request": {
						"method": "DELETE",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": { "raw": "{{base_url}}/comments/{{comment_id}}", "host": ["{{base_url}}"], "path": ["comments", "{{comment_id}}"] }
					}
				}
			]
		},
		{
			"name": "Users & Roles",
			"item": [
				{
					"name": "List Users (admin)",
					"request": {
						"method": "GET",
						"header": [ { "key": "Authorization", "value": "Bearer {{admin_token}}" } ],
						"url": { "raw": "{{base_url}}/users?role=user", "host": ["{{base_url}}"], "path": ["users"], "query": [ { "key": "role", "value": "user" } ] }
					}
				},
				{
					"name": "Promote User to Moderator (admin, nested route)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"moderator\"\n}"
						},
						"url": { "raw": "{{base_url}}/users/{{user_id}}/role", "host": ["{{base_url}}"], "path": ["users", "{{user_id}}", "role"] }
					}
				},
				{
					"name": "Upload Avatar (file upload)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "avatar", "type": "file", "src": [] }
							]
						},
						"url": { "raw": "{{base_url}}/user/avatar", "host": ["{{base_url}}"], "path": ["user", "avatar"] }
					}
				}
			]
		},
		{
			"name": "External Services",
			"item": [
				{
					"name": "Discussion Starter (dummyjson.com quote API)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/discussion-starter", "host": ["{{base_url}}"], "path": ["discussion-starter"] }
					}
				}
			]
		}
	]
